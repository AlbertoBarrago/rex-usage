{
  "name": "rex-usage",
  "version": "0.1.0",
  "description": "Nerdy TUI for Claude Code token and cost usage",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx src/cli.tsx --root \"$(tsx scripts/demo-data.ts)\"",
    "demo:data": "tsx scripts/demo-data.ts"
  },
  "author": "Alberto Barrago",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "rex-usage": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  }
}
